# Copy this file to ".env" and fill in real values. ".env" itself is git-ignored.

APP_NAME=OCR Document Processing System
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite connection string (relative to backend/)
DATABASE_URL=sqlite:///./database/app.db

# Maximum accepted upload size, in megabytes
MAX_UPLOAD_SIZE_MB=10

# --- Redis / Celery (batch processing) ---
#
# One setting is normally all you need. The broker (the task queue) and
# the result backend both fall back to REDIS_URL when left blank, so
# pointing this at a running Redis is the whole configuration.
#
# The same URL works for either Windows option, because nothing in the
# code knows which one is behind it:
#   * Memurai (native Windows service) -> redis://127.0.0.1:6379/0
#   * Redis under WSL2                 -> redis://127.0.0.1:6379/0
# WSL2 forwards localhost to the distro, so the host and port are
# identical; switching between them needs no change here.
REDIS_URL=redis://127.0.0.1:6379/0

# Leave both blank unless you deliberately want the queue and the task
# results on different Redis databases (e.g. .../0 and .../1).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Concurrent files per Celery worker process. The pipeline is I/O-bound
# (every stage is a Vertex AI call), so threads give real parallelism.
CELERY_WORKER_CONCURRENCY=4

# --- Batch processing ---
# Files accepted in one POST /batches/upload.
MAX_BATCH_FILES=500
# Per-file retry cap, counted in the database so it survives a restart.
MAX_FILE_RETRIES=3
# Hard/soft ceilings on one file's full pipeline, in seconds.
BATCH_FILE_TIME_LIMIT_SECONDS=300
BATCH_FILE_SOFT_TIME_LIMIT_SECONDS=270

# With no reachable Redis, run batches in an in-process thread pool
# instead of refusing the upload. Set to false to require a broker.
BATCH_INLINE_FALLBACK=true
BATCH_INLINE_MAX_WORKERS=2
# How long the upload waits for the broker before falling back.
BROKER_PROBE_TIMEOUT_SECONDS=1.5

# --- Google Cloud / Vertex AI ---
# Fill in your own GCP project id below, and see README.md ("Vertex AI
# credentials") for how to create credentials/gcp-service-account.json.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-service-account.json

VERTEX_OCR_MODEL=gemini-2.5-flash
VERTEX_OCR_TIMEOUT_SECONDS=120

VERTEX_CLASSIFICATION_MODEL=gemini-2.5-flash
VERTEX_CLASSIFICATION_TIMEOUT_SECONDS=60
VERTEX_CLASSIFICATION_MAX_TEXT_CHARS=8000

VERTEX_EXTRACTION_MODEL=gemini-2.5-flash
VERTEX_EXTRACTION_TIMEOUT_SECONDS=60
VERTEX_EXTRACTION_MAX_TEXT_CHARS=8000
